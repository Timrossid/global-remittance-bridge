# .env.example — Merchant Dashboard
# Copy to .env.local and fill in your real values. Never commit .env.local to version control.

# ─── API ──────────────────────────────────────────────────────────────────────
# The URL of your deployed Payment API.
# Local dev: http://localhost:3001
# Production: https://global-remittance-api.onrender.com (or your custom backend URL)
NEXT_PUBLIC_API_URL="https://global-remittance-api.onrender.com"

# ─── Stellar / Soroban ────────────────────────────────────────────────────────
# Network selection: "testnet" or "mainnet"
NEXT_PUBLIC_NETWORK="testnet"

# The deployed Soroban escrow contract ID (56-char C-address).
NEXT_PUBLIC_CONTRACT_ID="CD2YDPGFZCSXY3UAFJSO47GC5S3KDVECPL5SCCQQXIPTEBLDWMYPG44D"

# Soroban RPC used by the browser escrow flow.
NEXT_PUBLIC_SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"

# Token contract used by the browser escrow form (replace with your Testnet token C-address).
# Canonical native-XLM Stellar Asset Contract on Testnet:
NEXT_PUBLIC_ESCROW_TOKEN_ID="CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC"

# CI-only browser test seam; keep false or unset in production.
NEXT_PUBLIC_ENABLE_TEST_WALLET_MOCK="false"

# Optional feedback form link for the /feedback page.
NEXT_PUBLIC_FEEDBACK_FORM_URL=""

# ─── Sentry (error monitoring) ────────────────────────────────────────────────
# Client-side DSN (public). Leave blank to disable the SDK locally.
NEXT_PUBLIC_SENTRY_DSN=""
# Server-side DSN + webpack auth token. Set in your CI/deploy environment.
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG="global-remittance-bridge"
SENTRY_PROJECT="merchant-dashboard"

# ─── PostHog (product analytics) ──────────────────────────────────────────────
# Public PostHog project key. Leave blank to disable event capture locally.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
